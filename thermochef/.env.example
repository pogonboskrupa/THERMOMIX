# Claude / Anthropic API (required for OCR photo import)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cookidoo OAuth Client ID (optional, uses default mobile app client if not set)
COOKIDOO_CLIENT_ID=C01M001-ANDROID-APP-ANDROID

# App configuration
PORT=8000
ENV=development

# Database (default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///./thermochef.db
